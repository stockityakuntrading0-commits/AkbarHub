               Title = "Donasi Booth Berhasil! 🎉",
               Content = "Berhasil mendonasikan " .. tostring(robuxAmount) -> tostring(robuxAmount) .. " R$ ke " .. tostring(targetName) .. "! Sisa saldo: " .. tostring(_G.MyRobuxBalance) .. " R$",
